# Gere uma chave aleatória para o ambiente local; nunca reutilize esta referência.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# MySQL local. Informe usuário/senha existentes; o banco Bico não é criado automaticamente.
DB_ENGINE=mysql
DB_NAME=Bico
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=3

# Somente em desenvolvimento o projeto deriva uma chave de armazenamento local do DJANGO_SECRET_KEY.
# Ao preparar produção, configure chaves Fernet geradas e gerenciadas fora do repositório.
BICO_PROVIDER_DOCUMENT_ENCRYPTION_KEYS=

# Use origens completas, incluindo esquema, em produção.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0

# SMTP de produção; desenvolvimento usa o backend local em arquivo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_FROM=BICO <nao-responda@example.com>
EMAIL_TIMEOUT=10
