# Gere uma chave aleatória para o ambiente local; nunca reutilize esta referência.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL local. Crie o banco e usuário antes de executar migrate.
POSTGRES_DB=bico
POSTGRES_USER=bico
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Use origens completas, incluindo esquema, em produção.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
